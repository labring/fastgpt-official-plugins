{
  "name": "fastgpt-moderation-aliyun",
  "version": "1.0.0",
  "description": "Alibaba Cloud text content moderation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx @fastgpt-plugin/cli build --minify",
    "build:dev": "npx @fastgpt-plugin/cli build",
    "check": "npx @fastgpt-plugin/cli check --entry . --output ./dist",
    "dev": "fastgpt-plugin dev . --watch",
    "debug": "npx @fastgpt-plugin/cli debug .",
    "debug:run": "fastgpt-plugin debug . --run --input '{\"content\":\"Hello\"}'",
    "pack": "npx @fastgpt-plugin/cli pack",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@alicloud/green20220302": "3.6.9",
    "@alicloud/openapi-core": "^1.0.8",
    "@darabonba/typescript": "^1.0.6"
  },
  "devDependencies": {
    "@fastgpt-plugin/cli": "catalog:",
    "@fastgpt-plugin/sdk-factory": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "private": true
}
