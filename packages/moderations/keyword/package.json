{
  "name": "fastgpt-moderation-keyword",
  "version": "1.0.0",
  "description": "High-performance local keyword content moderation plugin powered by Aho-Corasick algorithm and open-source sensitive lexicon",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:moderation": "npx @fastgpt-plugin/cli build --minify",
    "build:dev": "npx @fastgpt-plugin/cli build",
    "check": "npx @fastgpt-plugin/cli check --entry . --output ./dist",
    "debug": "npx @fastgpt-plugin/cli debug .",
    "debug:run": "npx @fastgpt-plugin/cli debug . --run --input '{\"content\":\"点击浏览色情网站\"}'",
    "pack": "npx @fastgpt-plugin/cli pack",
    "pack:moderation": "npx @fastgpt-plugin/cli pack",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@fastgpt-plugin/cli": "catalog:",
    "@fastgpt-plugin/sdk-factory": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
