{
  "name": "fastgpt-tools-i18n-test",
  "version": "0.0.1",
  "description": "I18n metadata test tool for FastGPT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx @fastgpt-plugin/cli build --minify",
    "build:dev": "npx @fastgpt-plugin/cli build",
    "check": "npx @fastgpt-plugin/cli check --entry . --output ./dist",
    "dev": "fastgpt-plugin dev . --watch",
    "debug": "npx @fastgpt-plugin/cli debug .",
    "debug:run": "npx @fastgpt-plugin/cli debug . --run --input '{\"text\":\"Hello i18n\"}'",
    "pack": "npx @fastgpt-plugin/cli pack",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@fastgpt-plugin/cli": "catalog:",
    "@fastgpt-plugin/sdk-factory": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
