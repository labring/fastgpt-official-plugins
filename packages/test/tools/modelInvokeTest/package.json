{
  "name": "fastgpt-tools-model-invoke-test",
  "version": "0.0.1",
  "description": "Test model reverse invocation, streaming output, and usage billing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx @fastgpt-plugin/cli build --minify",
    "build:dev": "npx @fastgpt-plugin/cli build",
    "check": "npx @fastgpt-plugin/cli check --entry . --output ./dist",
    "dev": "fastgpt-plugin dev . --watch",
    "pack": "npx @fastgpt-plugin/cli pack",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "biome-check": "biome check . --write"
  },
  "dependencies": {},
  "devDependencies": {
    "@fastgpt-plugin/cli": "catalog:",
    "@fastgpt-plugin/sdk-factory": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
